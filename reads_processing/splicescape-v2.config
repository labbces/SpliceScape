// version 2.0.0
workDir = ""

// nextflow.config
params {
    user            = ""
    password        = "" 
    url             = ""
    
    db              = "${workDir}/name.sql" 
    outdir          = "${workDir}/output" // Output directory for the workflow
    backbonedir     = "${workDir}/backbone"
    species         = "ZmaysB84" // make sure species name is as it is on Phytozome - at least starts equal
    species_name    = "Zea mays"

    // Files
    reads_file      = ""
    genomeFASTA     = "/home/bia.estevam/landscapeSplicingGrasses/data/Phytozome/ZmaysB84/assembly/.fa" //update
    genomeGFF       = "/home/bia.estevam/landscapeSplicingGrasses/data/Phytozome/ZmaysB84/annotation/.gene_exons.gff3" // update
    genome_path     = "/home/bia.estevam/landscapeSplicingGrasses/data/Phytozome/ZmaysB84/assembly"  // update
    genome          = "/home/bia.estevam/landscapeSplicingGrasses/data/Phytozome/ZmaysB84"

    // STAR config
    threads         = 12

    // bbduk config
    bbduk           = "/Storage/progs/bbmap_35.85/bbduk2.sh"
    minlength       = 60
    trimq           = 20
    k               = 27
    rref            = "/Storage/progs/BBMap/resources/adapters.fa"
    maxmem          = "20g" //

    // SGSeq config
    r_libs          = "/R/library"
    sgseq_cores     = 30

    // MAJIQ config
    majiq_path      = "/majiq/bin"
    majiq_cores     = 12 // make sure it is the same as in your profile for MAJIQ_VOILA_MODULIZE!
    
    // intermediate files cleanup config
    rm_reads_scratch_raw = true
    rm_reads_scratch_clean = true
    rm_reads_inspect_bbduk_logs = false

    rm_mapping_inspect_bamfiles = false

    rm_majiq_scratch = true

    // rm_bam?

     
}

executor {
    queueSize = 100  // Controls total concurrent submissions
}

// reports 
report {
    enabled = true
    file = "report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "timeline.html" 
    overwrite = true
}

trace {
    enabled = true
    file = "trace.txt"
    overwrite = true
}

// set the default memory and cpu for processes 
profiles {
  sge {
    process {
      executor = 'sge'
      penv = 'smp'
      queue = 'all.q@telura.bioinfo.cluster'
      clusterOptions = '-S /bin/bash -V'
      scratch = false
      maxForks = 4

      // CPU slots are requested by Nextflow with -pe smp <task.cpus>.
      // Memory requirements are specified separately per process.

      withName: 'WGET_DOWNLOADER' {
        cpus = 8
        memory = '4 GB'
        maxForks = 1
      }

      withName: 'ALTERNATIVE_RUN_BBDUK' {
        cpus = 8
        memory = '24 GB'
      }

      withName: 'RUN_BBDUK' {
        cpus = 8
        memory = '24 GB'
      }

      withName: 'GENOME_GENERATE_STAR' {
        cpus = 12
        memory = '16 GB'
      }

      withName: 'MAPPING_STAR' {
        cpus = 12
        memory = '48 GB'
      }

      withName: 'SGSEQ' {
        cpus = 30
        memory = '90 GB'
        maxForks = 2
      }

      withName: 'MAJIQ_ANNOTATION_DB' {
        cpus = 8
        memory = '24 GB'
        maxForks = 1
      }

      withName: 'MAJIQ_SJ' {
        cpus = 4
        memory = '24 GB'
        maxForks = 1
      }

      withName: 'MAJIQ_BUILD' {
        cpus = 8
        memory = '24 GB'
        maxForks = 1
      }

      withName: 'MAJIQ_PSI' {
        cpus = 4
        memory = '24 GB'
        maxForks = 1
      }

      withName: 'MAJIQ_SG_COVERAGE' {
        cpus = 4
        memory = '24 GB'
        maxForks = 1
      }

      withName: 'CREATE_DB' {
        cpus = 4
        memory = '12 GB'
      }

      withName: 'POPULATE_DB' {
        cpus = 8
        memory = '24 GB'
      }

      withName: 'MAJIQ_VOILA_MODULIZE' {
        cpus = 16
        memory = '24 GB'
        maxForks = 1
      }
    }
  }

  local {
    process {
      executor = 'local'

      withName: 'WGET_DOWNLOADER' { cpus = 8
                                     memory = '4 GB' }

      withName: 'ALTERNATIVE_RUN_BBDUK' { cpus = 8
                                           memory = '24 GB' }

      withName: 'RUN_BBDUK' { cpus = 8
                               memory = '24 GB' }

      withName: 'GENOME_GENERATE_STAR' { cpus = 12
                                          memory = '16 GB' }

      withName: 'MAPPING_STAR' { cpus = 12
                                  memory = '48 GB' }

      withName: 'SGSEQ' { cpus = 8
                           memory = '10 GB' }

      // withName: 'MAJIQ_RUN' { cpus = 8
      //                          memory = '10 GB' }

      withName: 'MAJIQ_ANNOTATION_DB' { cpus = 8
                                         memory = '24 GB' }

      withName: 'MAJIQ_SJ' { cpus = 4
                              memory = '24 GB' }

      withName: 'MAJIQ_BUILD' { cpus = 8
                                 memory = '24 GB' }

      withName: 'MAJIQ_PSI' { cpus = 4
                               memory = '24 GB' }

      withName: 'MAJIQ_SG_COVERAGE' { cpus = 4
                                       memory = '24 GB' }

      withName: 'CREATE_DB' { cpus = 4
                               memory = '12 GB' }

      withName: 'POPULATE_DB' { cpus = 8
                                 memory = '24 GB' }

      withName: 'MAJIQ_VOILA_MODULIZE' { cpus = 16
                                          memory = '24 GB' }
    }
  }
}

// dont change it
workflow {
  failOnIgnore = false
}

