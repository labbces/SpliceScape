// SpliceScape v2.6 — Nextflow execution settings only.
// Biological inputs, paths, cleanup options and max_active_samples
// must be specified in the JSON passed with -params-file.
// CPU/memory and scheduler-specific settings remain here.

executor {
    queueSize = 100  // Controls total concurrent submissions
}

// reports 
report {
    enabled = true
    file = "report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "timeline.html" 
    overwrite = true
}

trace {
    enabled = true
    file = "trace.txt"
    overwrite = true
}

// set the default memory and cpu for processes 
profiles {
  sge {
    process {
      executor = 'sge'
      penv = 'smp'
      queue = 'introns.q'
      clusterOptions = '-S /bin/bash -V'
      scratch = false
      // Per-process ceiling; lifecycle admission is controlled separately.
      maxForks = (params.max_active_samples ?: 2) as int

      // Nextflow uses penv and task.cpus for SGE slot requests.
      // Memory requirements are specified separately per process.

      withName: 'WGET_DOWNLOADER' {
        cpus = 8
        memory = '4 GB'
      }

      withName: 'ALTERNATIVE_RUN_BBDUK' {
        cpus = 8
        memory = '24 GB'
      }

      withName: 'RUN_BBDUK' {
        cpus = 8
        memory = '24 GB'
      }

      withName: 'GENOME_GENERATE_STAR' {
        cpus = 12
        memory = '16 GB'
      }

      withName: 'MAPPING_STAR' {
        cpus = 12
        memory = '48 GB'
      }

      withName: 'SGSEQ' {
        cpus = 30
        memory = '90 GB'
      }

      withName: 'MAJIQ_ANNOTATION_DB' {
        cpus = 8
        memory = '24 GB'
        maxForks = 1
      }

      withName: 'MAJIQ_SJ' {
        cpus = 4
        memory = '24 GB'
      }

      withName: 'MAJIQ_BUILD' {
        cpus = 8
        memory = '24 GB'
      }

      withName: 'MAJIQ_PSI' {
        cpus = 4
        memory = '24 GB'
      }

      withName: 'MAJIQ_SG_COVERAGE' {
        cpus = 4
        memory = '24 GB'
      }

      withName: 'CREATE_DB' {
        cpus = 4
        memory = '12 GB'
      }

      withName: 'POPULATE_DB' {
        cpus = 8
        memory = '24 GB'
      }

      withName: 'COMMIT_DB_MICROBATCH' {
        cpus = 8
        memory = '24 GB'
        maxForks = 1
      }

      withName: 'MAJIQ_VOILA_MODULIZE' {
        cpus = 16
        memory = '24 GB'
      }
    }
  }

  local {
    process {
      executor = 'local'

      maxForks = (params.max_active_samples ?: 2) as int

      withName: 'WGET_DOWNLOADER' { cpus = 8
                                     memory = '4 GB' }

      withName: 'ALTERNATIVE_RUN_BBDUK' { cpus = 8
                                           memory = '24 GB' }

      withName: 'RUN_BBDUK' { cpus = 8
                               memory = '24 GB' }

      withName: 'GENOME_GENERATE_STAR' { cpus = 12
                                          memory = '16 GB' }

      withName: 'MAPPING_STAR' { cpus = 12
                                  memory = '48 GB' }

      withName: 'SGSEQ' { cpus = 8
                           memory = '10 GB' }

      withName: 'MAJIQ_ANNOTATION_DB' { cpus = 8
                                         memory = '24 GB' }

      withName: 'MAJIQ_SJ' { cpus = 4
                              memory = '24 GB' }

      withName: 'MAJIQ_BUILD' { cpus = 8
                                 memory = '24 GB' }

      withName: 'MAJIQ_PSI' { cpus = 4
                               memory = '24 GB' }

      withName: 'MAJIQ_SG_COVERAGE' { cpus = 4
                                       memory = '24 GB' }

      withName: 'CREATE_DB' { cpus = 4
                               memory = '12 GB' }

      withName: 'POPULATE_DB' { cpus = 8
                                 memory = '24 GB' }

      withName: 'COMMIT_DB_MICROBATCH' {
        cpus = 8
        memory = '24 GB'
        maxForks = 1
      }

      withName: 'MAJIQ_VOILA_MODULIZE' { cpus = 16
                                          memory = '24 GB' }
    }
  }
}

workflow {
  failOnIgnore = false
}

